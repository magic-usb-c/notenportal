{
  "enabledPlugins": {
    "caveman@caveman": true,
    "laravel@laravel": true,
    "laravel-lsp@laravel": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": false,
    "tailwind-v4-shadcn@claude-skills": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(php artisan:*)",
      "Bash(php -r:*)",
      "Bash(php -v)",
      "Bash(composer show:*)",
      "Bash(composer validate:*)",
      "Bash(composer install)",
      "Bash(composer dump-autoload:*)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm ci)",
      "Bash(npm test:*)",
      "Bash(npx prettier:*)",
      "Bash(./vendor/bin/pint:*)",
      "Bash(./vendor/bin/phpstan:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(/usr/bin/grep:*)",
      "Bash(/usr/bin/find:*)",
      "Bash(/usr/bin/head:*)",
      "Bash(/usr/bin/tail:*)",
      "Bash(/usr/bin/sed:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(curl -s:*)",
      "Bash(curl -sk:*)",
      "Bash(node:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo rm:*)",
      "Bash(sudo mysql:*)",
      "Bash(mysql -u root:*)",
      "Bash(DROP DATABASE:*)",
      "Bash(composer install:*)",
      "Bash(composer update:*)",
      "Bash(composer require:*)",
      "Bash(sudo systemctl:*)",
      "Bash(sudo a2*:*)",
      "Bash(./install.sh:*)",
      "Bash(sudo ./install.sh:*)",
      "Read(./.env)",
      "Read(./tmp-testdaten/**)",
      "Edit(./.env)",
      "Write(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/view-pruefung.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
