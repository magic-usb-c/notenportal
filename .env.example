# Vorlage für die .env. Bei einer Installation mit "sudo ./install.sh" wird die .env
# fertig geschrieben – diese Datei brauchst du dann nicht. Sie ist für eine Installation
# von Hand und für Entwicklungsumgebungen gedacht: kopieren, ausfüllen, Schlüssel erzeugen.
#
#   cp .env.example .env && php artisan key:generate
#
# Die .env enthält Passwörter und gehört niemals in die Versionsverwaltung.

# Im Betrieb: production und false. Zur Entwicklung: APP_ENV=local und APP_DEBUG=true,
# damit Fehler als Stapelspur sichtbar werden statt als leere Seite. Umgekehrt niemals
# mit APP_DEBUG=true in den Betrieb: die Fehlerseite zeigt sonst Pfade, Konfiguration
# und Datenbankabfragen.
APP_NAME=Notenportal
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Weitere Namen/IPs, unter denen das Portal aufgerufen wird (kommagetrennt); schreibt install.sh
TRUSTED_HOSTS=

APP_TIMEZONE=Europe/Zurich
APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH

BCRYPT_ROUNDS=12

# Im Betrieb: daily/warning. Zur Entwicklung: stack/debug.
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Zwei Datenbankbenutzer nach dem Prinzip der geringsten Rechte.
# DB_USERNAME darf nur Daten lesen und schreiben – kein CREATE, kein ALTER, kein DROP.
# DB_MIGRATE_* darf das Schema ändern und wird ausschliesslich von
# "php artisan notenportal:migrate" verwendet. Ohne diese zwei Angaben laufen
# Migrationen nicht; das normale "php artisan migrate" ist hier nicht der Weg.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=notenportal
DB_USERNAME=notenportal_web
DB_PASSWORD=
DB_MIGRATE_USERNAME=notenportal_migrate
DB_MIGRATE_PASSWORD=

# Sitzungen als Datei, damit eine Schemaänderung niemanden abmeldet.
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Auf true setzen, sobald HTTPS steht: dann verlässt das Sitzungscookie den Browser nur verschlüsselt.
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Der Kalenderabgleich weist Adressen auf privaten Netzen ab, damit niemand das Portal
# als Sprungbrett in das interne Netz benutzt. Liegt der Schulnetz-Kalender genau dort,
# muss dieser Schutz bewusst geöffnet werden – dann nur in einem vertrauenswürdigen Netz
# und im Wissen, dass eingetragene Adressen danach jeden erreichbaren Dienst ansprechen.
CALENDAR_ALLOW_PRIVATE=false

# MAIL_MAILER=log schreibt Mails in die Logdatei, statt sie zu versenden – der sichere
# Anfangszustand. Der empfohlene Weg zum echten SMTP-Server führt über das Portal:
# Admin → Betrieb → E-Mail, mit Testmail und ohne Eingriff in Dateien. Einträge hier
# greifen nur, solange im Portal nichts hinterlegt ist.
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
