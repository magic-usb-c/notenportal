diff --git a/resources/js/np.js b/resources/js/np.js
index ffaac06..8f9030b 100644
--- a/resources/js/np.js
+++ b/resources/js/np.js
@@ -204,6 +204,30 @@ export function registriereFenster() {
     document.addEventListener('visibilitychange', setze);
 }
 
+// Lichtbrechung am Kapselrand: html[data-brechung] nur, wenn der Browser einen SVG-Filter als backdrop-filter
+// zeichnet. Erkennung per JS, nie per @supports (Firefox meldet url() als unterstützt und zeichnet es nicht,
+// Bug 1961378): Chromium-Engine, Filter #np-brechung im Dokument (nur layouts/app) und ein Probe-Element, dessen
+// berechneter backdrop-filter die url() behält. Die Ausschlüsse (Bewegung, Transparenz, Kontrast, Palette) stehen
+// im CSS. Prüfschalter für Messungen ohne Brechung: localStorage 'np-brechung' = 'aus' (--brechung=aus).
+export function registriereBrechung() {
+    try {
+        if (localStorage.getItem('np-brechung') === 'aus') return;
+    } catch {
+        /* Speicher gesperrt: Erkennung läuft weiter */
+    }
+    const marken = navigator.userAgentData?.brands ?? [];
+    if (!marken.some((m) => m.brand === 'Chromium')) return;
+    if (!(document.getElementById('np-brechung') instanceof SVGFilterElement)) return;
+
+    const probe = document.createElement('div');
+    probe.style.position = 'absolute';
+    probe.style.backdropFilter = 'url(#np-brechung)';
+    document.body.append(probe);
+    const wert = getComputedStyle(probe).backdropFilter;
+    probe.remove();
+    if (wert.includes('url(')) document.documentElement.dataset.brechung = '';
+}
+
 // Seitenleiste angedockt oder als Schublade: html[data-leiste]. Angedockt nur ab 64rem Breite und bei
 // Navigation «seite»; die Materialregel der Schublade hängt an diesem Attribut. Den Wechsel von
 // data-navigation meldet der MutationObserver von npLeistenUeberlauf (leisteAktualisieren).
